        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "client",
              "server",
              "database",
              "cache",
              "queue",
              "worker",
              "gateway",
              "storage",
              "ai-provider",
              "external-api",
              "host",
              "vm",
              "edge-device",
              "sensor",
              "generic"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "technology": {
            "type": "string"
          },
          "groupId": {
            "type": "string",
            "minLength": 1
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "hostId": {
            "type": "string",
            "minLength": 1
          },
          "replicas": {
            "type": "object",
            "properties": {
              "min": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "max": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "ephemeral": {
                "type": "boolean"
              }
            },
            "required": [
              "min"
            ]
          },
          "hardware": {
            "type": "object",
            "properties": {
              "cpuCores": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "memoryGb": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "diskGb": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "gpu": {
                "type": "string"
              },
              "os": {
                "type": "string"
              },
              "location": {
                "type": "string"
              },
              "address": {
                "type": "string"
              },
              "powerWatts": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          },
          "sensor": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "camera",
                  "environmental",
                  "radar",
                  "generic"
                ]
              },
              "resolution": {
                "type": "string"
              },
              "fps": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "bitrateMbps": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "codec": {
                "type": "string"
              },
              "sampleHz": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "detectionsPerSecond": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "readingBytes": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "type"
            ]
          },
          "layout": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "w": {
                "type": "number"
              },
              "h": {
                "type": "number"
              },
              "expanded": {
                "type": "boolean"
              }
            },
            "required": [
              "x",
              "y"
            ]
          },
          "details": {
            "type": "object",
            "properties": {
              "routes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "method": {
                      "type": "string",
                      "enum": [
                        "GET",
                        "POST",
                        "PUT",
                        "PATCH",
                        "DELETE",
                        "HEAD",
                        "OPTIONS",
                        "WS",
                        "ANY"
                      ]
                    },
                    "path": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "method",
                    "path"
                  ]
                }
              },
              "entities": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
