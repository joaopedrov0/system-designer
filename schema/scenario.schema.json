            "type": "boolean"
          },
          "uses": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "layout": {
            "type": "object",
            "properties": {
              "sourceHandle": {
                "type": "string"
              },
              "targetHandle": {
                "type": "string"
              }
            }
          }
        },
        "required": [
          "id",
          "source",
          "target"
        ]
      }
    },
    "groups": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "parentId": {
            "type": "string",
            "minLength": 1
          },
          "layout": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "w": {
                "type": "number"
              },
              "h": {
                "type": "number"
              }
            },
            "required": [
              "x",
              "y",
              "w",
              "h"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "layout"
        ]
      }
    },
    "notes": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string"
          },
          "layout": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "w": {
                "type": "number"
              },
              "h": {
                "type": "number"
              }
            },
            "required": [
              "x",
              "y"
            ]
          }
        },
        "required": [
          "id",
          "text",
          "layout"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "name",
    "createdAt",
    "updatedAt"
  ],
  "$id": "https://system-designer.local/schema/scenario.v1.json",
  "title": "System Designer — cenário",
  "description": "Descreve um sistema de software: componentes, conexões entre eles e detalhes opcionais (rotas, tabelas, modelos de IA, tópicos, variáveis). Só `kind` e `name` são obrigatórios em um componente; o restante é complexidade progressiva."
}
