{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "createdAt": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    },
    "components": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "client",
              "server",
              "database",
              "cache",
              "queue",
              "worker",
              "gateway",
              "storage",
              "ai-provider",
              "external-api",
              "generic"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "technology": {
            "type": "string"
          },
          "groupId": {
            "type": "string",
            "minLength": 1
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "layout": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "w": {
                "type": "number"
              },
              "h": {
                "type": "number"
              },
              "expanded": {
                "type": "boolean"
              }
            },
            "required": ["x", "y"]
          },
          "details": {
            "type": "object",
            "properties": {
              "routes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "method": {
                      "type": "string",
                      "enum": [
                        "GET",
                        "POST",
                        "PUT",
                        "PATCH",
                        "DELETE",
                        "HEAD",
                        "OPTIONS",
                        "WS",
                        "ANY"
                      ]
                    },
                    "path": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    }
                  },
                  "required": ["id", "method", "path"]
                }
              },
              "entities": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "fields": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string",
                            "minLength": 1
                          },
                          "type": {
                            "type": "string"
                          }
                        },
                        "required": ["name"]
                      }
                    },
                    "layout": {
                      "type": "object",
                      "properties": {
                        "x": {
                          "type": "number"
                        },
                        "y": {
                          "type": "number"
                        }
                      },
                      "required": ["x", "y"]
                    }
                  },
                  "required": ["id", "name"]
                }
              },
              "models": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "purpose": {
                      "type": "string"
                    }
                  },
                  "required": ["id", "name"]
                }
              },
              "topics": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": ["id", "name"]
                }
              },
              "screens": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "path": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    },
                    "layout": {
                      "type": "object",
                      "properties": {
                        "x": {
                          "type": "number"
                        },
                        "y": {
                          "type": "number"
                        }
                      },
                      "required": ["x", "y"]
                    }
                  },
                  "required": ["id", "name"]
                }
              },
              "env": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "key": {
                      "type": "string",
                      "minLength": 1
                    },
                    "value": {
                      "type": "string"
                    },
                    "secret": {
                      "type": "boolean"
                    },
                    "description": {
                      "type": "string"
                    }
                  },
                  "required": ["key"]
                }
              },
              "notes": {
                "type": "string"
              },
              "navigation": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "from": {
                      "type": "string",
                      "minLength": 1
                    },
                    "to": {
                      "type": "string",
                      "minLength": 1
                    },
                    "label": {
                      "type": "string"
                    }
                  },
                  "required": ["id", "from", "to"]
                }
              },
              "relations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "from": {
                      "type": "string",
                      "minLength": 1
                    },
                    "to": {
                      "type": "string",
                      "minLength": 1
                    },
                    "cardinality": {
                      "type": "string",
                      "enum": ["1:1", "1:N", "N:N"]
                    },
                    "label": {
                      "type": "string"
                    }
                  },
                  "required": ["id", "from", "to"]
                }
              }
            }
          }
        },
        "required": ["id", "kind", "name", "layout"]
      }
    },
    "connections": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "protocol": {
            "type": "string",
            "enum": ["http", "grpc", "websocket", "sql", "event", "sdk", "ipc", "file", "generic"]
          },
          "label": {
            "type": "string"
          },
          "direction": {
            "type": "string",
            "enum": ["one-way", "two-way"]
          },
          "async": {
            "type": "boolean"
          },
          "uses": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "layout": {
            "type": "object",
            "properties": {
              "sourceHandle": {
                "type": "string"
              },
              "targetHandle": {
                "type": "string"
              }
            }
          }
        },
        "required": ["id", "source", "target"]
      }
    },
    "groups": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "parentId": {
            "type": "string",
            "minLength": 1
          },
          "layout": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "w": {
                "type": "number"
              },
              "h": {
                "type": "number"
              }
            },
            "required": ["x", "y", "w", "h"]
          }
        },
        "required": ["id", "name", "layout"]
      }
    },
    "notes": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string"
          },
          "layout": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "w": {
                "type": "number"
              },
              "h": {
                "type": "number"
              }
            },
            "required": ["x", "y"]
          }
        },
        "required": ["id", "text", "layout"]
      }
    }
  },
  "required": ["schemaVersion", "id", "name", "createdAt", "updatedAt"],
  "$id": "https://system-designer.local/schema/scenario.v1.json",
  "title": "System Designer — cenário",
  "description": "Descreve um sistema de software: componentes, conexões entre eles e detalhes opcionais (rotas, tabelas, modelos de IA, tópicos, variáveis). Só `kind` e `name` são obrigatórios em um componente; o restante é complexidade progressiva."
}
